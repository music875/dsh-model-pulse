{
  "name": "dsh-workbuddy-pulse",
  "version": "1.1.0",
  "type": "module",
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "WorkBuddy 脉搏",
      "en": "WB pulse"
    },
    "icon": "chart",
    "contributes": {
      "composer.strip": [
        {
          "id": "pulse",
          "icon": "chart",
          "panel": "pulse-panel"
        }
      ],
      "panels": [
        {
          "id": "pulse-panel",
          "title": {
            "zh": "WorkBuddy 脉搏",
            "en": "WB pulse"
          },
          "icon": "chart",
          "placement": [
            "features",
            "chat.panel"
          ]
        }
      ]
    }
  },
  "description": "通用模型状态条 for dsh-go：峰谷/拥堵/积分/余额，适配 WorkBuddy 及 8 家官方 API",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-go",
    "deepseek-harness",
    "workbuddy",
    "credits",
    "balance",
    "quota",
    "peak",
    "busy",
    "model-status"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/music875/dsh-workbuddy-pulse.git"
  }
}